{
  "name": "wastewise-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "test": "node --experimental-strip-types --test tests/domain.test.ts",
    "api:types": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src e2e tests *.ts *.json index.html"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "22.15.29",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.0",
    "openapi-typescript": "7.8.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  }
}
